# Resuélvelo — Variables de entorno
# Copiar este archivo como .env.local y completar con los valores reales.
# Obtener en: https://supabase.com → Project Settings → API
#
# Local y Vercel Preview → proyecto Supabase de DESARROLLO
# Vercel Production      → proyecto Supabase de PRODUCCIÓN
# Los nombres son los mismos; en Vercel se separan por entorno
# (Settings → Environment Variables → Production / Preview).
# NUNCA commitear valores reales ni cadenas de conexión con contraseña.

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable-key>

# URL pública de la app (sin slash final)
# Local:      http://localhost:3000
# Preview:    https://resuelvelo-dev.vercel.app
# Production: https://resuelvelo.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Canal de soporte (página /contacto). Ambas son opcionales: si faltan,
# la página muestra textos de ejemplo en lugar de enlaces.
# WhatsApp: número internacional solo con dígitos, sin "+", espacios ni guiones
# (se usa para https://wa.me/<numero>).
NEXT_PUBLIC_SOPORTE_WHATSAPP=18095550123
NEXT_PUBLIC_SOPORTE_EMAIL=soporte@resuelveloapp.com

# Solo para la CLI de Supabase (migraciones). Va en .env.local, nunca en Vercel.
# DIRECT_CONN_STRING=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
