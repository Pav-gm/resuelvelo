190-      <main>
191-        {/* If there's any dynamic content inside this boundary, it will be streamed in */}
192:        <Suspense fallback={<BlogListSkeleton />}>
193-          <BlogList />
194:        </Suspense>
195-      </main>
196-    </div>
197-  )
198-}
