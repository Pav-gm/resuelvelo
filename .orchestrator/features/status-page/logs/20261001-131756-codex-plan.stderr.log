212-
213-export default async function Component() {
214-  await connection()
215-  // cookies, headers, and other Request-time APIs
216-  // will also opt into dynamic rendering, meaning
217:  // this env variable is evaluated at runtime
218-  const value = process.env.MY_VALUE
219-  // ...
220-}
221-```
222-
223-```jsx filename="app/page.js" switcher
224-import { connection } from 'next/server'
225-
226-export default async function Component() {
227-  await connection()
228-  // cookies, headers, and other Request-time APIs
229-  // will also opt into dynamic rendering, meaning
230:  // this env variable is evaluated at runtime
231-  const value = process.env.MY_VALUE
232-  // ...
233-}
234-```
235-
236-</AppOnly>
